{
  "name": "@mbx/icons",
  "version": "0.5.1",
  "description": "Outline icon library for the barber trade, shared by the MyBarber apps, admin dashboard and website.",
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/motion": {
      "types": "./dist/react/motion/index.d.ts",
      "default": "./dist/react/motion/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "default": "./dist/react-native/index.js"
    },
    "./svg/*": "./dist/svg/*",
    "./sprite.svg": "./dist/sprite.svg",
    "./icons.json": "./dist/icons.json",
    "./package.json": "./package.json",
    "./frosted": {
      "types": "./dist/frosted/index.d.ts",
      "default": "./dist/frosted/index.js"
    },
    "./frosted/svg/*": "./dist/frosted/svg/*",
    "./frosted/png/*": "./dist/frosted/png/*"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "docs",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-frosted.mjs",
    "prepare": "node scripts/build.mjs && node scripts/build-frosted.mjs",
    "check": "npm run build && git diff --quiet -- dist docs || (echo \"dist/ is stale \u2014 run npm run build and commit\" && exit 1)"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native-svg": ">=13"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Diverso-digitech/mbx-icons.git"
  },
  "devDependencies": {
    "sharp": "^0.34.3"
  }
}
